10 REM OLED.BAS: tries out a 128x64 SSD1309 (or SSD1306) OLED on I2C.
20 REM Wire SDA to GP2, SCL to GP3 (I2C1), VCC to 3.3 V and GND. The
30 REM display is at &H3C (some are &H3D: change A). Shows text, a
40 REM checkerboard, a sine wave, contrast, invert and a live counter.
50 A = &H3C
60 I2C OPEN 2, 3, 400
70 ON ERROR GOTO 2000
80 GOSUB 1000: ON ERROR GOTO 0
90 GOSUB 1100: GOSUB 1200
100 R = 0: C = 0: T$ = "PICO BASIC": GOSUB 1300
110 R = 2: T$ = "SSD1309 128X64 OLED": GOSUB 1300
120 R = 4: T$ = "I2C1 GP2/GP3 AT &H" + HEX$(A): GOSUB 1300
130 R = 5: T$ = "ABCDEFGHIJKLMNOPQRSTU": GOSUB 1300
135 R = 6: T$ = "VWXYZ 0123456789": GOSUB 1300
140 R = 7: T$ = "!#$%&()*+,-./:;<=>?@": GOSUB 1300
150 PAUSE 3000
200 REM Checkerboard of 8x8 squares, then the same inverted
210 B$ = "": FOR I = 1 TO 8: B$ = B$ + STRING$(8, 255) + STRING$(8, 0): NEXT
220 W$ = MID$(B$, 9) + STRING$(8, 255)
230 GOSUB 1250
240 FOR P = 0 TO 7
250   IF P MOD 2 THEN I2C WRITE A, &H40, W$ ELSE I2C WRITE A, &H40, B$
260 NEXT
270 PAUSE 1500: I2C WRITE A, 0, &HA7: PAUSE 1500: I2C WRITE A, 0, &HA6
300 REM Sine wave and its axis, built a page (8 rows) at a time
310 DIM Y(127): FOR X = 0 TO 127: Y(X) = 32 - INT(28 * SIN(X * 3.14159 / 32)): NEXT
320 GOSUB 1250
330 FOR P = 0 TO 7
340   S$ = ""
350   FOR X = 0 TO 127
360     V = 0: IF Y(X) \ 8 = P THEN V = BT(Y(X) MOD 8)
370     IF P = 4 AND X MOD 2 = 0 THEN V = V OR 1
380     S$ = S$ + CHR$(V)
390   NEXT
400   I2C WRITE A, &H40, S$
410 NEXT
420 PAUSE 1000
500 REM Contrast down and back up
510 FOR V = 255 TO 0 STEP -15: I2C WRITE A, 0, &H81, V: PAUSE 40: NEXT
520 FOR V = 0 TO 255 STEP 15: I2C WRITE A, 0, &H81, V: PAUSE 40: NEXT
530 I2C WRITE A, 0, &H81, &HCF: PAUSE 1000
600 REM A box with a counter that updates in place
610 GOSUB 1200
620 GOSUB 1250
630 I2C WRITE A, &H40, CHR$(255) + STRING$(126, 1) + CHR$(255)
640 FOR P = 1 TO 6: I2C WRITE A, &H40, CHR$(255) + STRING$(126, 0) + CHR$(255): NEXT
650 I2C WRITE A, &H40, CHR$(255) + STRING$(126, 128) + CHR$(255)
660 R = 2: C = 34: T$ = "PICO BASIC": GOSUB 1300
670 R = 3: C = 10: T$ = "SAYS HELLO TO YOU": GOSUB 1300
680 T0 = TIMER
690 FOR N = 0 TO 100
700   R = 5: C = 40: T$ = "N = " + RIGHT$("  " + MID$(STR$(N), 2), 3): GOSUB 1300
710 NEXT
720 T$ = STR$(INT((TIMER - T0) * 10) / 10) + " S": R = 6: C = 64 - 3 * LEN(T$): GOSUB 1300
730 PRINT "Done: 101 counter updates took"; T$
740 I2C CLOSE
750 END
1000 REM Starts the display: off, clock, 64 rows, no offset, start line 0,
1010 REM flipped both ways (pins at the top), COM pins, contrast, precharge,
1020 REM VCOMH, horizontal addressing, show RAM, not inverted, then on. For
1030 REM an SSD1306 put &H8D, &H14 (its charge pump) before the &HAF.
1040 I2C WRITE A, 0, &HAE, &HD5, &HA0, &HA8, &H3F, &HD3, 0, &H40, &HA1, &HC8
1050 I2C WRITE A, 0, &HDA, &H12, &H81, &HCF, &HD9, &HF1, &HDB, &H40, &H20, 0
1060 I2C WRITE A, 0, &HA4, &HA6, &HAF
1070 RETURN
1100 REM Loads the 5x7 font (space to Z) as 6-byte column strings G$()
1110 DIM G$(58), BT(7): H$ = "0123456789ABCDEF"
1120 FOR I = 0 TO 7: BT(I) = INT(2 ^ I + .5): NEXT
1130 FOR I = 0 TO 58
1140   READ D$: S$ = ""
1150   FOR J = 1 TO 9 STEP 2
1160     S$ = S$ + CHR$((INSTR(H$, MID$(D$, J, 1)) - 1) * 16 + INSTR(H$, MID$(D$, J + 1, 1)) - 1)
1170   NEXT
1180   G$(I) = S$ + CHR$(0)
1190 NEXT: RETURN
1200 REM Clears the whole display
1210 GOSUB 1250
1220 Z$ = STRING$(128, 0)
1230 FOR P = 0 TO 7: I2C WRITE A, &H40, Z$: NEXT
1240 RETURN
1250 REM Sets the write window to the whole display (columns 0-127, pages 0-7)
1260 I2C WRITE A, 0, &H21, 0, 127, &H22, 0, 7: RETURN
1300 REM Prints T$ on text row R (0-7) from pixel column C (0-127), 6
1310 REM pixels a character; lower case is shown as capitals
1320 S$ = ""
1330 FOR I = 1 TO LEN(T$)
1340   K = ASC(MID$(T$, I, 1)): IF K > 96 AND K < 123 THEN K = K - 32
1350   IF K < 32 OR K > 90 THEN K = 63
1360   S$ = S$ + G$(K - 32)
1370 NEXT
1380 I2C WRITE A, 0, &H21, C, 127, &H22, R, R
1390 I2C WRITE A, &H40, LEFT$(S$, 128 - C)
1400 RETURN
2000 PRINT "No display answered at &H"; HEX$(A); " (check the wiring, or try &H3D)"
2010 I2C CLOSE: END
